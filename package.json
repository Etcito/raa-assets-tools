{
  "name": "@etcito/raa-assets-tools",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest/index.d.ts",
      "import": "./dist/manifest/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./schema": "./schema/raa.prims.v0.schema.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "raa-assets": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "schema",
    "fixtures",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --test test/"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/node": "^22.18.0"
  }
}
